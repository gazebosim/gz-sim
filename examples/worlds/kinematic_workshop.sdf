    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_15</name>
      <pose>1.25 0 0.33 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_16</name>
      <pose>1.35 0 0.33 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
