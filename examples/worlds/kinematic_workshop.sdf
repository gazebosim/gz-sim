    <!-- Dynamic cargo on the ferry -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_crate_large</uri>
      <name>ferry_crate_0</name>
      <pose>-3.236 1.7068 1.77 0 0 -1.9878</pose>
