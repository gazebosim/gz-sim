    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_35</name>
      <pose>1.45 0 0.69 0 0 1.5708</pose>
    </include>

    <!-- Dynamic cargo on the carousel -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_crate_blue</uri>
      <name>crate_00</name>
      <pose>-3.52 2.6 0.24 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_crate_light</uri>
      <name>crate_01</name>
      <pose>-3.52 2.6 0.48 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_crate_blue</uri>
