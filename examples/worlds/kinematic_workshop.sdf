    <!-- 4. Show: the timeline that plays the stations -->

    <!--
      The show: one looping timeline drives the arm and the carousel, then
      puts the blocks and the carousel cargo back.
    -->
    <plugin filename="gz-sim-timeline-publisher-system"
            name="gz::sim::systems::TimelinePublisher">
      <loop>true</loop>
      <period>30.0</period>
      <keyframe time="0.0">
        <output topic="/model/arm/joint/yaw/0/cmd_pos" type="gz.msgs.Double">
          data: 0.0
        </output>
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: 0.45</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 1.2
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.75
        </output>
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 0.0 }
        </output>
      </keyframe>
      <keyframe time="1.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 0.5 }
        </output>
      </keyframe>
      <keyframe time="2.5">
        <output topic="/model/arm/joint/yaw/0/cmd_pos" type="gz.msgs.Double">
          data: -1.5
        </output>
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: 0.8</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 1.0
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.4
        </output>
      </keyframe>
      <keyframe time="4.0">
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: 1.45</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 0.25
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.0
        </output>
      </keyframe>
      <keyframe time="5.2">
        <output topic="/model/arm/joint/yaw/0/cmd_pos" type="gz.msgs.Double">
          data: 1.7
        </output>
      </keyframe>
      <keyframe time="6.8">
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: -0.35</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 0.5
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.9
        </output>
      </keyframe>
      <keyframe time="9.0">
        <output topic="/model/arm/joint/yaw/0/cmd_pos" type="gz.msgs.Double">
          data: 2.55
        </output>
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: 0.55</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 0.75
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.6
        </output>
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 0.9 }
        </output>
      </keyframe>
      <keyframe time="11.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 1.3 }
        </output>
      </keyframe>
      <keyframe time="12.0">
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.2
        </output>
      </keyframe>
      <keyframe time="13.0">
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.9
        </output>
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 1.7 }
        </output>
      </keyframe>
      <keyframe time="14.0">
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.2
        </output>
      </keyframe>
      <keyframe time="15.0">
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.9
        </output>
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 2.1 }
        </output>
      </keyframe>
      <keyframe time="17.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 2.6 }
        </output>
      </keyframe>
      <keyframe time="19.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 3.2 }
        </output>
      </keyframe>
      <keyframe time="20.0">
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: -2.5</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 1.6
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 1.0
        </output>
      </keyframe>
      <keyframe time="21.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 1.6 }
        </output>
      </keyframe>
      <keyframe time="22.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 0.6 }
        </output>
      </keyframe>
      <keyframe time="23.0">
        <output topic="/model/carousel/cmd_vel" type="gz.msgs.Twist">
          angular { z: 0.0 }
        </output>
      </keyframe>
      <keyframe time="24.0">
        <output topic="/model/arm/joint/yaw/0/cmd_pos" type="gz.msgs.Double">
          data: 0.0
        </output>
        <output topic="/model/arm/joint/shoulder/0/cmd_pos"
                type="gz.msgs.Double">data: 0.45</output>
        <output topic="/model/arm/joint/elbow/0/cmd_pos" type="gz.msgs.Double">
          data: 1.2
        </output>
        <output topic="/model/arm/joint/wrist/0/cmd_pos" type="gz.msgs.Double">
          data: 0.75
        </output>
      </keyframe>
