    </include>

    <!-- 3. Environment: floor, walls and lights -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.045 0.05 0.06 1</diffuse>
            <pbr>
              <metal>
                <metalness>0.0</metalness>
                <roughness>0.35</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="platform">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>2.7</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.12 0.125 0.14 1</diffuse>
            <pbr>
              <metal>
                <metalness>0.05</metalness>
                <roughness>0.7</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="ring">
          <pose>1.35 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>1.6</radius>
              <length>0.012</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.085 0.09 0.1 1</diffuse>
            <pbr>
              <metal>
                <metalness>0.05</metalness>
                <roughness>0.75</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_arena_wall</uri>
      <name>arena_wall</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_carousel_wall</uri>
      <name>carousel_wall</name>
      <pose>-4.2 2.6 0 0 0 0</pose>
    </include>

    <!--
      Lighting: a dim cool moon, warm key spots on each station, a teal rim
      from behind, and orange wash lights along the arena wall.
    -->
    <light type="directional" name="moon">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <visualize>false</visualize>
      <diffuse>0.16 0.19 0.26 1</diffuse>
      <specular>0.1 0.1 0.12 1</specular>
