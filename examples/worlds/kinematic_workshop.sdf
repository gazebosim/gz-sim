<?xml version="1.0" ?>
<!--
  Kinematic workshop: a demo of kinematic links interacting with dynamic
  bodies using the gz-physics-bullet-featherstone plugin.

  Orange parts are kinematic: they ignore gravity and contact forces and only
  move as commanded with velocities. Blue parts are dynamic and react to them.

  - A kinematic arm, driven by JointPositionController in velocity mode,
    swings through a tower of blocks.
  - A carousel spins up until its cargo flies off.
  - A ferry flies a circle in mid air with loose cargo on its deck. Fly it
    yourself with the "Fly the ferry" panel.
  - A TimelinePublisher plays the show, then puts the blocks and the carousel
    cargo back, every 30 seconds.

  The models come from the kinematic_workshop collection on Fuel and are
  downloaded on the first run:
  https://app.gazebosim.org/caguero/fuel/collections/kinematic_workshop

  How to read this file:

  A link with <kinematic>true</kinematic> moves only as commanded: gravity
  and contacts never move it. Links without it are dynamic. The file is
  ordered by role:

  1. Stations, the kinematic parts. Each one is a Fuel model whose links
     already declare <kinematic>true</kinematic>: its <include> adds the
     plugins that drive it.
     - Arm: kinematic from the base to the forearm, with a dynamic hand at
       the end (a hybrid chain). A JointPositionController in velocity mode
       drives each joint, and a force torque sensor in the wrist measures
       the load on the hand.
     - Carousel: one kinematic link, driven by VelocityControl.
     - Ferry: one kinematic link, driven by VelocityControl or by the
       Teleop panel in the GUI.
  2. Props, the dynamic objects: the tower blocks and the cargo.
  3. Environment: floor, walls and lights.
  4. Show: a TimelinePublisher sends the arm targets and the carousel
     speeds, and puts the props back every 30 seconds.

  Run with:

    gz sim -r kinematic_workshop.sdf

  Watch the load on the hand with:

    gz topic -e -t /arm/hand_ft
-->
<sdf version="1.11">
  <world name="kinematic_workshop">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!--
        20 solver iterations instead of the default 50 make the world
        run faster
      -->
      <bullet>
        <solver>
          <iters>20</iters>
        </solver>
      </bullet>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system"
            name="gz::sim::systems::ForceTorque"/>

    <gz:policies>
      <include_gui_default_plugins>false</include_gui_default_plugins>
    </gz:policies>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.16 0.16 0.19</ambient_light>
        <background_color>0.0055 0.0065 0.0095</background_color>
        <camera_pose>4.7 -5.2 3.0 0 0.278 2.24</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>100</far>
        </camera_clip>
        <!-- In degrees -->
        <horizontal_fov>75</horizontal_fov>
        <shadows>
          <texture_size light_type="directional">4096</texture_size>
        </shadows>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="Teleop" name="Fly the ferry">
        <gz-gui>
          <title>Fly the ferry</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="bool" key="resizable">true</property>
          <property type="double" key="width">330</property>
          <property type="double" key="height">690</property>
          <property type="string" key="cardBackground">#F0F0F0</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <topic>/model/ferry/cmd_vel</topic>
      </plugin>
    </gui>

    <scene>
      <ambient>0.16 0.16 0.19 1</ambient>
      <background>0.0055 0.0065 0.0095 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <!-- 1. Stations: the kinematic parts and what drives them -->

    <!--
      A hybrid arm: every link up to the forearm is kinematic, so gravity
      and contacts never move it. The hand at the end of the chain is
      dynamic: gravity pulls on it and the blocks push back. The
      kinematic joints move exactly as commanded, while the wrist is
      driven by a joint motor. A force torque sensor in the wrist measures
      the load on the hand.
    -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_arm/3</uri>
      <name>arm</name>
      <pose>0 0 0 0 0 0</pose>
      <!--
        What drives the arm: each joint listens for a position target on
        /model/arm/joint/<joint>/0/cmd_pos and moves there with joint
        velocity commands, capped at cmd_max.
      -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>yaw</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>3.5</cmd_max>
        <cmd_min>-3.5</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>shoulder</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>1.6</cmd_max>
        <cmd_min>-1.6</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>elbow</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>1.8</cmd_max>
        <cmd_min>-1.8</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>wrist</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </plugin>
    </include>

    <!--
      Carousel: a single kinematic link spun by a velocity command. The
      objects on it are dynamic and ride along by friction alone.
    -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_carousel/3</uri>
      <name>carousel</name>
      <pose>-4.2 2.6 0.08 0 0 0</pose>
      <!--
        What drives the carousel: velocity commands on
        /model/carousel/cmd_vel, sent by the show timeline.
      -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_angular>0 0 0</initial_angular>
      </plugin>
    </include>

    <!--
      Flying ferry: a single kinematic link that hovers with no support.
      VelocityControl applies a body frame twist, so a constant forward
      speed and turn rate fly a circle of radius 3.8 m. Use the Teleop
      panel in the GUI to fly it yourself.
    -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_ferry/3</uri>
      <name>ferry</name>
      <pose>-3.4744 1.539 1.6 0 0 -1.9878</pose>
      <!--
        What drives the ferry: velocity commands on /model/ferry/cmd_vel.
        It starts with a constant twist that flies the circle; the Teleop
        panel publishes on the same topic.
      -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>0.795870 0 0</initial_linear>
        <initial_angular>0 0 0.209440</initial_angular>
      </plugin>
    </include>

    <!-- 2. Props: the dynamic objects that the stations move -->

    <!-- Tower of dynamic blocks -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_00</name>
      <pose>1.35 -0.1 0.03 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_01</name>
      <pose>1.35 0 0.03 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_02</name>
      <pose>1.35 0.1 0.03 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_03</name>
      <pose>1.25 0 0.09 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_04</name>
      <pose>1.35 0 0.09 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_05</name>
      <pose>1.45 0 0.09 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_06</name>
      <pose>1.35 -0.1 0.15 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_07</name>
      <pose>1.35 0 0.15 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_08</name>
      <pose>1.35 0.1 0.15 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_09</name>
      <pose>1.25 0 0.21 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_10</name>
      <pose>1.35 0 0.21 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_light</uri>
      <name>block_11</name>
      <pose>1.45 0 0.21 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_12</name>
      <pose>1.35 -0.1 0.27 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_13</name>
      <pose>1.35 0 0.27 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
