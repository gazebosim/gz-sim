      <pose>1.35 0 0.39 0 0 0.0000</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/caguero/models/kinematic_workshop_block_blue</uri>
      <name>block_20</name>
      <pose>1.35 0.1 0.39 0 0 0.0000</pose>
    </include>
    <include>
