<?xml version="1.0" ?>
<!--
  Example URDF robot demonstrating SDFormat URDF-to-SDF fixed-joint lumping
  (see frame_ids_joint_lumping.sdf).

  Contains three fixed-joint sensor mounts on `base_link`:
    1. `imu_link` (lumped into `base_link`, sensor `imu_sensor` has NO <frame_id>):
       - Lumped away by sdformat; sensor moves onto `base_link` with pose (0.2, 0, 0.3).
       - Publishes with frame_id = "imu_sensor" (mismatching URDF link `imu_link`).
    2. `lidar_link` (lumped into `base_link`, sensor `gpu_lidar` HAS <frame_id>lidar_link</frame_id>):
       - Lumped away by sdformat; sensor moves onto `base_link` with pose (0.6, 0, 0.4).
       - Publishes with frame_id = "lidar_link" (matching URDF link `lidar_link`).
       - Without `publish_sensor_pose=true` (or external `robot_state_publisher`),
         `base_link -> lidar_link` is missing from PosePublisher because `lidar_link`
         is no longer a link entity in Gazebo!
       - With `publish_sensor_pose=true`, PosePublisher reconstructs `base_link -> lidar_link`
         from the lumped sensor's offset pose on `base_link`.
    3. `preserved_imu_link` (preserved via <preserveFixedJoint>true</preserveFixedJoint>,
       sensor `preserved_imu` HAS <frame_id>preserved_imu_link</frame_id>):
       - Remains a distinct link entity in Gazebo (`base_link -> preserved_imu_link`
         is published as a link transform).
       - With `publish_sensor_pose=true`, PosePublisher sees `frame == childFrame`
         (`preserved_imu_link -> preserved_imu_link`) and skips the redundant self-transform.
-->
<robot name="lumped_robot">

  <link name="base_link">
    <inertial>
      <origin xyz="-0.15 0 0.175" rpy="0 0 0"/>
      <mass value="1.14395"/>
      <inertia ixx="0.126164" ixy="0" ixz="0" iyy="0.416519" iyz="0" izz="0.481014"/>
    </inertial>
    <visual>
      <origin xyz="-0.15 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.15 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- 1. Lumped fixed joint WITHOUT <frame_id> -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.2 0 0.3" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
    </sensor>
  </gazebo>

  <!-- 2. Lumped fixed joint WITH <frame_id>lidar_link</frame_id> -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.6 0 0.4" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <frame_id>lidar_link</frame_id>
      <update_rate>5</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 3. Preserved fixed joint WITH <preserveFixedJoint>true</preserveFixedJoint>
          and <frame_id>preserved_imu_link</frame_id> -->
  <link name="preserved_imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="preserved_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="preserved_imu_link"/>
    <origin xyz="-0.4 0 0.3" rpy="0 0 0"/>
  </joint>
  <gazebo reference="preserved_imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="preserved_imu_link">
    <sensor name="preserved_imu" type="imu">
      <frame_id>preserved_imu_link</frame_id>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
    </sensor>
  </gazebo>

  <!-- Wheels & Caster -->
  <link name="left_wheel">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.145833" ixy="0" ixz="0" iyy="0.145833" iyz="0" izz="0.125"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.3"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.3"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.55 0.625 -0.025" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.145833" ixy="0" ixz="0" iyy="0.145833" iyz="0" izz="0.125"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.3"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.3"/></geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.55 -0.625 -0.025" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.2"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="0.2"/></geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.95 0 -0.125" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.25</wheel_separation>
      <wheel_radius>0.3</wheel_radius>
      <odom_publish_frequency>5</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>
