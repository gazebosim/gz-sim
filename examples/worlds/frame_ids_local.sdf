<?xml version="1.0" ?>
<!--
  Frame ID Policy Demo: local (default, Pattern A: isolated /robotN/tf trees)

  Run the simulation:
    export GZ_IP=127.0.0.1
    gz sim -r frame_ids_local.sdf

  Send velocity commands:
    gz topic -t /robot1/cmd_vel -m gz.msgs.Twist -p "linear: {x: 0.5}, angular: {z: 0.2}"
    gz topic -t /robot2/cmd_vel -m gz.msgs.Twist -p "linear: {x: 0.5}, angular: {z: -0.2}"

  Inspect frame_id / child_frame_id on Gazebo topics (all unprefixed local names):
    gz topic -e -t /robot1/odometry -n 1
    gz topic -e -t /robot1/tf -n 1
    gz topic -e -t /robot1/imu -n 1
    gz topic -e -t /robot1/scan -n 1
    gz topic -e -t /model/robot1/pose -n 1
    gz topic -e -t /model/robot1/pose_static -n 1

  Bridge with ros_gz_bridge (e.g. for robot1):
    ros2 run ros_gz_bridge parameter_bridge \
      /robot1/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist \
      /robot1/odometry@nav_msgs/msg/Odometry[gz.msgs.Odometry \
      /robot1/tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V \
      /robot1/imu@sensor_msgs/msg/Imu[gz.msgs.IMU \
      /robot1/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan \
      /model/robot1/pose@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V \
      /model/robot1/pose_static@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
-->
<sdf version="1.12">
  <world name="frame_ids_local">
    <!-- Default policy is <frame_ids>local</frame_ids> even if omitted -->
    <gz:policies>
      <frame_ids>local</frame_ids>
    </gz:policies>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle box for lidar returns -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="box_link">
        <collision name="collision">
          <geometry><box><size>1 4 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 4 1</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot 1: explicit namespace="robot1" -->
    <model name="robot1" namespace="robot1">
      <pose>0 1.5 0.325 0 0 0</pose>

      <link name="chassis">
        <pose>-0.151427 0 0.175 0 0 0</pose>
        <inertial>
          <mass>1.14395</mass>
          <inertia>
            <ixx>0.126164</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.416519</iyy><iyz>0</iyz><izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
          <material>
            <ambient>0.2 0.4 1.0 1</ambient>
            <diffuse>0.2 0.4 1.0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
        </collision>

        <!-- IMU sensor with default frame_id -> resolves to "imu_sensor" -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/robot1/imu</topic>
        </sensor>
      </link>

      <!-- Dedicated lidar link attached via fixed joint -->
      <link name="lidar_link">
        <pose>0.6 0 0.55 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>0.1</length></cylinder></geometry>
        </visual>
        <!-- GPU Lidar with explicit <frame_id>lidar_link</frame_id>;
             PosePublisher will automatically skip the lidar_link -> lidar_link self-transform -->
        <sensor name="gpu_lidar" type="gpu_lidar">
          <frame_id>lidar_link</frame_id>
          <topic>/robot1/scan</topic>
          <update_rate>5</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>64</samples>
                <resolution>1</resolution>
                <min_angle>-1.57</min_angle>
                <max_angle>1.57</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
      </joint>

      <link name="left_wheel">
        <pose>0.554283 0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>0.554282 -0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
      </link>

      <link name="caster">
        <pose>-0.957138 0 -0.125 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="caster_wheel" type="ball">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <!-- DiffDrive with NO <frame_id> or <child_frame_id>:
           defaults to "odom" -> "chassis" under local policy -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>1.25</wheel_separation>
        <wheel_radius>0.3</wheel_radius>
        <odom_publish_frequency>5</odom_publish_frequency>
      </plugin>

      <!-- PosePublisher with static_publisher=true:
           - Dynamic (/model/robot1/pose): world -> robot1, chassis -> left_wheel, chassis -> right_wheel, chassis -> caster
           - Static (/model/robot1/pose_static): robot1 -> chassis, chassis -> lidar_link, chassis -> imu_sensor -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_sensor_pose>true</publish_sensor_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <update_frequency>5</update_frequency>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
    </model>

    <!-- Robot 2: namespace="{name}" placeholder -->
    <model name="robot2" namespace="{name}">
      <pose>0 -1.5 0.325 0 0 0</pose>

      <link name="chassis">
        <pose>-0.151427 0 0.175 0 0 0</pose>
        <inertial>
          <mass>1.14395</mass>
          <inertia>
            <ixx>0.126164</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.416519</iyy><iyz>0</iyz><izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
        </collision>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/robot2/imu</topic>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0.554283 0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>0.554282 -0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
      </link>

      <link name="caster">
        <pose>-0.957138 0 -0.125 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="caster_wheel" type="ball">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>1.25</wheel_separation>
        <wheel_radius>0.3</wheel_radius>
        <odom_publish_frequency>5</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
