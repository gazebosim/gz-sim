<?xml version="1.0"?>
<model>
  <name>simplified_physics_diff_drive</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    A differential drive robot for the tests of the SimplifiedPhysics system.
    The model has no knowledge of the physics mode: including it with
    experimental:params chooses one.
  </description>
</model>
