<?xml version="1.0" ?>
<!--
  One model file, two physics modes. The planar model gets the
  SimplifiedPhysicsModel plugin from <experimental:params> at include time, so
  the model file has no knowledge of it.
-->
<sdf version="1.9">
  <world name="simplified_physics_include_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-simplified-physics-system"
      name="gz::sim::systems::SimplifiedPhysics">
    </plugin>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>40 40 0.2</size></box>
          </geometry>
        </collision>
      </link>
      <pose>0 0 -0.1 0 0 0</pose>
    </model>

    <include>
      <uri>model://simplified_physics_amr</uri>
      <name>amr_full</name>
      <pose>0 0 1 0 0 0</pose>
    </include>

    <include>
      <uri>model://simplified_physics_amr</uri>
      <name>amr_planar</name>
      <pose>0 4 1 0 0 0</pose>
      <experimental:params>
        <plugin element_id="" action="add"
            name="gz::sim::systems::SimplifiedPhysicsModel"
            filename="gz-sim-simplified-physics-system">
          <mode>planar_kinematic</mode>
        </plugin>
      </experimental:params>
    </include>
  </world>
</sdf>
