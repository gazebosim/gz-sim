<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hydrodynamics_time">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <!-- prevent sinking -->
    <gravity>0 0 0</gravity>

    <!-- Current Data -->
    <plugin
      filename="gz-sim-environment-preload-system"
      name="gz::sim::systems::EnvironmentPreload">
      <data>@CMAKE_SOURCE_DIR@/test/worlds/hydrodynamic_currents_time.csv</data>
      <dimensions>
        <time>timestamp</time>
        <space>
          <x>x</x>
          <y>y</y>
          <z>z</z>
        </space>
      </dimensions>
    </plugin>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <model name="sphere_turning">
      <link name="sphere_turning_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>40</mass>
          <inertia>
            <ixx>0.4</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.4</iyy>
            <iyz>0</iyz>
            <izz>0.4</izz>
          </inertia>
        </inertial>

        <visual name='sphere_turning_visual'>
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
        </visual>
        <collision name='sphere_turning_collision'>
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
        <link_name>sphere_turning_link</link_name>
        <water_density>918</water_density>
        <xDotU>0</xDotU>
        <yDotV>0</yDotV>
        <zDotW>0</zDotW>
        <kDotP>0</kDotP>
        <mDotQ>0</mDotQ>
        <nDotR>0</nDotR>
        <xUabsU>-94.2475</xUabsU>
        <xU>0</xU>
        <yVabsV>-94.2475</yVabsV>
        <yV>0</yV>
        <zWabsW>-94.2475</zWabsW>
        <zW>0</zW>
        <kPP>0</kPP>
        <kP>0</kP>
        <mQQ>0</mQQ>
        <mQ>0</mQ>
        <nRR>0</nRR>
        <nR>0</nR>
        <lookup_current_x>current_x</lookup_current_x>
        <lookup_current_y>current_y</lookup_current_y>
        <lookup_current_z>current_z</lookup_current_z>
      </plugin>
    </model>
  </world>
</sdf>
