<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="camera_sensor">
    <physics name="fast" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <model name="relative_topics" namespace="{name}_ns">
      <static>true</static>
      <pose>-6 2 2 0 0.5 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <pose>1 0 1.3 0 0 0</pose>
          <topic>camera_relative</topic>
          <camera>
            <triggered>true</triggered>
            <trigger_topic>trigger_relative</trigger_topic>
            <camera_info_topic>camera_info_relative</camera_info_topic>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="absolute_topics" namespace="{name}_ns">
      <pose>20 0 0.5 0 0 0.0 </pose>
      <static>true</static>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <update_rate>50</update_rate>
          <topic>/camera_absolute</topic>
          <camera>
            <triggered>true</triggered>
            <trigger_topic>/trigger_absolute</trigger_topic>
            <camera_info_topic>/camera_info_absolute</camera_info_topic>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="default_topics" namespace="{name}_ns">
      <pose>10 0 0.5 0 0 0.0 </pose>
      <static>true</static>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <update_rate>50</update_rate>
          <camera>
            <triggered>true</triggered>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="rgbd_default_topics" namespace="{name}_ns">
      <pose>10 0 0.5 0 0 0.0 </pose>
      <static>true</static>
      <link name="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <update_rate>50</update_rate>
          <camera>
            <triggered>true</triggered>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
